rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用 ----------
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        // 只限學校帳戶
        && request.auth.token.email.lower().matches('.*@lwcps[.]edu[.]hk$')
        // 封鎖學生帳戶（s + 數字，例如 s123456@lwcps.edu.hk）
        && !request.auth.token.email.lower().matches('^s[0-9]+@lwcps[.]edu[.]hk$');
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // 管理員名單：文件 ID = 管理員電郵（小楷），只能在 Firebase Console 或由管理員加入
    match /admins/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    // ---------- 樂Kids TV ----------
    match /ktv_sessions/{date} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /ktv_bookings/{id} {
      allow read: if signedIn();

      // 老師提交申請：只能以自己身份、狀態必須是「審批中」、該日須開放預約，並同時建立時段鎖
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.teacherEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.slot is int
        && request.resource.data.slot >= 0 && request.resource.data.slot < 4
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 0 && request.resource.data.topic.size() <= 60
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0 && request.resource.data.teacherName.size() <= 40
        && request.resource.data.remarks.size() <= 300
        && get(/databases/$(database)/documents/ktv_sessions/$(request.resource.data.sessionId)).data.open == true
        && getAfter(/databases/$(database)/documents/ktv_slots/$(request.resource.data.sessionId + '_' + string(request.resource.data.slot))).data.bookingId == id
      );

      // 老師只可以把自己「審批中」的申請改為「已取消」；其他更改只限管理員
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );

      allow delete: if isAdmin();
    }

    // 時段鎖：ID = 日期_時段，確保同一時段只有一份有效申請（已存在時老師無法覆蓋）
    match /ktv_slots/{slotId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && slotId == request.resource.data.sessionId + '_' + string(request.resource.data.slot)
        && getAfter(/databases/$(database)/documents/ktv_bookings/$(request.resource.data.bookingId)).data.uid == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- 電郵佇列（Trigger Email 擴充功能） ----------
    match /mail/{id} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }
  }
}
