rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用 ----------
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        // 只限學校帳戶
        && request.auth.token.email.lower().matches('.*@lwcps[.]edu[.]hk$')
        // 封鎖學生帳戶（s + 數字，例如 s123456@lwcps.edu.hk）
        && !request.auth.token.email.lower().matches('^s[0-9]+@lwcps[.]edu[.]hk$');
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }


    // 管理員名單：文件 ID = 管理員電郵（小楷），可在「平台設定」新增或移除
    match /admins/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      // 只可加入學校教職員帳戶（不接受學生帳戶）
      allow create, update: if isAdmin()
        && email.matches('^[^@]+@lwcps[.]edu[.]hk$')
        && !email.matches('^s[0-9]+@lwcps[.]edu[.]hk$');
      // 不可移除自己，避免沒有管理員
      allow delete: if isAdmin() && email != request.auth.token.email;
    }

    // ---------- 樂Kids TV ----------
    // 設定（樂Kids TV 播放日）
    match /ktv_settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /ktv_bookings/{id} {
      allow read: if signedIn();

      // 老師提交申請：只能以自己身份、狀態必須是「審批中」，並同時建立時段鎖
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.teacherEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['regular', 'custom']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.start is string
        && request.resource.data.start.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.end is string
        && request.resource.data.end.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.start < request.resource.data.end
        && request.resource.data.lockId == request.resource.data.date + '_' + request.resource.data.start.replace(':', '')
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 0 && request.resource.data.topic.size() <= 60
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0 && request.resource.data.teacherName.size() <= 40
        && request.resource.data.remarks.size() <= 300
        && getAfter(/databases/$(database)/documents/ktv_slots/$(request.resource.data.lockId)).data.bookingId == id
      );

      // 老師只可以把自己「審批中」的申請改為「已取消」；其他更改只限管理員
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );

      allow delete: if isAdmin();
    }

    // 時段鎖：ID = 日期_開始時間（例如 2026-10-09_1310），已存在時老師無法覆蓋
    match /ktv_slots/{lockId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/ktv_bookings/$(request.resource.data.bookingId)).data.lockId == lockId
        && getAfter(/databases/$(database)/documents/ktv_bookings/$(request.resource.data.bookingId)).data.uid == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- 增加彩色列印限額申請 ----------
    match /print_requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.applicantName is string
        && request.resource.data.applicantName.size() > 0 && request.resource.data.applicantName.size() <= 40
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.remarks.size() <= 300
        && (!('applicantEmail' in request.resource.data)
            || (request.resource.data.applicantEmail.matches('^[^@]+@lwcps[.]edu[.]hk$')
                && !request.resource.data.applicantEmail.matches('^s[0-9]+@lwcps[.]edu[.]hk$')));
      // 老師只可把自己「處理中」的申請改為「已取消」
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // ---------- Copilot借用申請 ----------
    match /copilot_requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.applicantName is string
        && request.resource.data.applicantName.size() > 0 && request.resource.data.applicantName.size() <= 40
        && request.resource.data.group is string && request.resource.data.group.size() > 0
        && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.startDate <= request.resource.data.endDate
        && request.resource.data.days is int && request.resource.data.days >= 1 && request.resource.data.days <= 14
        && request.resource.data.purposes is list && request.resource.data.purposes.size() > 0
        && request.resource.data.otherPurpose.size() <= 100
        && (!('applicantEmail' in request.resource.data)
            || (request.resource.data.applicantEmail.matches('^[^@]+@lwcps[.]edu[.]hk$')
                && !request.resource.data.applicantEmail.matches('^s[0-9]+@lwcps[.]edu[.]hk$')));
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // ---------- iPad借用記錄表 ----------
    // 所有資料存於 ipad/state 一份文件：老師只可修改 bookings；
    // iPad 批次、課節、IT組預留、外借記錄只限管理員修改
    match /ipad/{doc} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookings'])
      );
      allow delete: if false;
    }

    // ---------- 樂天資訊站預約 ----------
    match /infostation_bookings/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.applicantName is string
        && request.resource.data.applicantName.size() > 0 && request.resource.data.applicantName.size() <= 40
        && request.resource.data.activity is string
        && request.resource.data.activity.size() > 0 && request.resource.data.activity.size() <= 80
        && request.resource.data.devices is list
        && request.resource.data.devices.size() > 0 && request.resource.data.devices.size() <= 4
        && request.resource.data.slots is list
        && request.resource.data.slots.size() > 0 && request.resource.data.slots.size() <= 200
        && request.resource.data.content is string && request.resource.data.content.size() <= 1000
        && request.resource.data.firstDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.lastDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (request.resource.data.applicantEmail.matches('^[^@]+@lwcps[.]edu[.]hk$')
            && !request.resource.data.applicantEmail.matches('^s[0-9]+@lwcps[.]edu[.]hk$'));
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // ---------- 電子器材損壞報告 ----------
    // 老師只可新增及查看自己的報告；跟進及完成維修只限管理員
    match /repair_reports/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'open'
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0 && request.resource.data.teacherName.size() <= 40
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0 && request.resource.data.location.size() <= 60
        && request.resource.data.device is string
        && request.resource.data.device.size() > 0 && request.resource.data.device.size() <= 80
        && request.resource.data.problem is string
        && request.resource.data.problem.size() > 0 && request.resource.data.problem.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    // ---------- 器材資產管理（只限管理員） ----------
    match /asset_items/{id} {
      allow read, write: if isAdmin();
    }
    match /asset_history/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;   // 操作記錄不可修改或刪除
    }

    // ---------- IT組工作資料（只限管理員；內容已在瀏覽器以主密碼加密） ----------
    match /itdesk_meta/{id} {
      allow read, write: if isAdmin();
    }
    match /itdesk_pages/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- QEF iPad管理（只限管理員，含學生個人資料） ----------
    match /qef_devices/{id} {
      allow read, write: if isAdmin();
    }
    match /qef_applicants/{id} {
      allow read, write: if isAdmin();
    }
    match /qef_history/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;   // 歷史記錄不可修改或刪除
    }

    // ---------- 平台設定 ----------
    // settings/notify：接收申請通知的管理員電郵；settings/schoolYear：目前學年；settings/systems：已隱藏的系統
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- 電郵佇列（Trigger Email 擴充功能） ----------
    // 管理員可寄給任何人；老師只可寄給「接收通知」的管理員名單（平台不會寄電郵給老師）
    match /mail/{id} {
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.keys().hasOnly(['to', 'message', 'createdAt', 'replyTo'])
        && (
          request.resource.data.to == get(/databases/$(database)/documents/settings/notify).data.ktv
          || request.resource.data.to == get(/databases/$(database)/documents/settings/notify).data.print
          || request.resource.data.to == get(/databases/$(database)/documents/settings/notify).data.copilot
          || request.resource.data.to == get(/databases/$(database)/documents/settings/notify).data.infostation
          || request.resource.data.to == get(/databases/$(database)/documents/settings/notify).data.repair
          || request.resource.data.to == get(/databases/$(database)/documents/settings/notify).data.emails
        )
      );
      // 管理員可在「平台設定」查看寄送結果
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
